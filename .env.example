# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
# ---------------------------------------------------------------------------

# Database. SQLite for local dev; swap the provider in prisma/schema.prisma to
# "postgresql" and point this at your instance for production.
DATABASE_URL="file:./dev.db"

# Session signing key. REQUIRED in production and must be at least 32 chars —
# the server refuses to boot without it. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=""

# Absolute public origin. Used for password-reset links, payment redirects,
# sitemap URLs and OpenGraph metadata. No trailing slash.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional integrations — every one of these degrades gracefully when unset.
# ---------------------------------------------------------------------------

# Transactional email. Without a key, mail is printed to the server console
# (including password-reset links), which is what you want in development.
RESEND_API_KEY=""
EMAIL_FROM="BSA <crew@bsa.dev>"

# HubSpot CRM. Without a key, leads are still stored locally and marked SKIPPED.
HUBSPOT_API_KEY=""
HUBSPOT_PORTAL_ID=""

# Payments. MODULAR_GATEWAY runs the built-in in-app checkout at /checkout/[txn].
# Setting STRIPE requires implementing createCheckoutSession in src/lib/payment.ts.
PAYMENT_PROVIDER="MODULAR_GATEWAY"
STRIPE_SECRET_KEY=""
