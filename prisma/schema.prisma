generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String               @id @default(uuid())
  email            String               @unique
  passwordHash     String
  role             String               @default("MEMBER")
  status           String               @default("ACTIVE")
  emailVerified    Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  applications     Application[]
  memberships      ChapterMembership[]
  receivedMessages ChatMessage[]        @relation("ReceivedMessages")
  sentMessages     ChatMessage[]        @relation("SentMessages")
  chatReads        ChatRead[]
  registrations    EventRegistration[]
  formSubmissions  FormSubmission[]
  profile          MemberProfile?
  resetTokens      PasswordResetToken[]
  payments         Payment[]
  resourceProgress ResourceProgress[]
  notifications    SiteNotification[]

  @@index([role])
}

model MemberProfile {
  id                  String         @id @default(uuid())
  userId              String         @unique
  fullName            String
  handle              String         @unique
  headline            String
  org                 String
  jobTitle            String         @default("")
  field               String         @default("Security")
  memberType          String         @default("PROFESSIONAL")
  location            String
  bio                 String
  yearsExperience     Int?
  avatarUrl           String?
  linkedinUrl         String?
  websiteUrl          String?
  twitterUrl          String?
  phone               String?
  contactEmail        String?
  specialties         String         @default("[]")
  skills              String         @default("[]")
  openToOpportunities Boolean        @default(false)
  openToMentoring     Boolean        @default(false)
  openToSpeaking      Boolean        @default(false)
  knownDevices        String         @default("[]")
  lastActiveAt        DateTime       @default(now())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  privacy             MemberPrivacy?
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([memberType])
  @@index([org])
  @@index([field])
}

model MemberPrivacy {
  id                    String        @id @default(uuid())
  profileId             String        @unique
  isPublic              Boolean       @default(true)
  searchableInDirectory Boolean       @default(true)
  showEmail             Boolean       @default(false)
  showPhone             Boolean       @default(false)
  showOrg               Boolean       @default(true)
  showLinkedIn          Boolean       @default(true)
  showWebsite           Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  profile               MemberProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([searchableInDirectory, isPublic])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Resource {
  id          String           @id @default(uuid())
  slug        String           @unique
  title       String
  summary     String
  description String
  imageUrl    String?
  level       String           @default("FOUNDATION")
  accent      String           @default("lime")
  emoji       String           @default("⬡")
  estHours    Int              @default(4)
  sortOrder   Int              @default(0)
  isPublished Boolean          @default(true)
  createdAt   DateTime         @default(now())
  modules     ResourceModule[]

  @@index([isPublished, sortOrder])
}

model ResourceModule {
  id          String             @id @default(uuid())
  resourceId  String
  title       String
  summary     String
  content     String
  sortOrder   Int                @default(0)
  minutes     Int                @default(20)
  resourceUrl String?
  resource    Resource           @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  progress    ResourceProgress[]

  @@index([resourceId, sortOrder])
}

model ResourceProgress {
  id          String         @id @default(uuid())
  userId      String
  moduleId    String
  completedAt DateTime       @default(now())
  module      ResourceModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([userId])
}

model Opportunity {
  id            String        @id @default(uuid())
  slug          String        @unique
  title         String
  org           String
  logoUrl       String?
  coverImageUrl String?
  type          String        @default("ROLE")
  locationType  String        @default("REMOTE")
  location      String
  compensation  String?
  description   String
  requirements  String        @default("[]")
  applyUrl      String?
  deadline      DateTime?
  isPublished   Boolean       @default(true)
  postedAt      DateTime      @default(now())
  applications  Application[]

  @@index([isPublished, type])
  @@index([postedAt])
}

model Application {
  id            String      @id @default(uuid())
  opportunityId String
  userId        String?
  name          String
  email         String
  org           String?
  profileUrl    String?
  note          String?
  status        String      @default("RECEIVED")
  createdAt     DateTime    @default(now())
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id])

  @@unique([opportunityId, email])
  @@index([opportunityId])
  @@index([userId])
}

model Chapter {
  id             String              @id @default(uuid())
  slug           String              @unique
  name           String
  region         String
  city           String
  country        String              @default("United Kingdom")
  description    String
  imageUrl       String?
  /// Real coordinates, so the globe plots this chapter where it actually is.
  latitude       Float?
  longitude      Float?
  emoji          String              @default("⬡")
  accent         String              @default("violet")
  foundedYear    Int                 @default(2024)
  meetingCadence String              @default("Quarterly")
  linkedinUrl    String?
  contactEmail   String?
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  memberships    ChapterMembership[]

  @@index([isActive])
}

model ChapterMembership {
  id        String   @id @default(uuid())
  chapterId String
  userId    String
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chapterId, userId])
  @@index([userId])
}

model Event {
  id            String              @id @default(uuid())
  title         String
  slug          String              @unique
  description   String
  fullDetails   String
  category      String              @default("CONFERENCE")
  eventDate     DateTime
  endDate       DateTime?
  startTime     String              @default("09:00 AM")
  endTime       String              @default("05:00 PM")
  location      String
  locationType  String              @default("HYBRID")
  venueName     String?
  maxCapacity   Int                 @default(200)
  isPaid        Boolean             @default(false)
  status        String              @default("UPCOMING")
  heroImageUrl  String?
  videoUrl      String?
  cpdHours      Int                 @default(0)
  agendaJson    String              @default("[]")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  registrations EventRegistration[]
  speakers      EventSpeaker[]
  sponsors      EventSponsor[]
  tickets       EventTicket[]

  @@index([status, eventDate])
  @@index([category])
}

model EventSpeaker {
  id        String  @id @default(uuid())
  eventId   String
  name      String
  title     String
  company   String
  avatarUrl String?
  bio       String?
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model Sponsor {
  id            String         @id @default(uuid())
  name          String
  logoUrl       String
  tier          String         @default("GOLD")
  description   String
  websiteUrl    String
  ctaText       String?        @default("Learn More")
  ctaUrl        String?
  isHiring      Boolean        @default(false)
  perkText      String?
  isPublished   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  eventSponsors EventSponsor[]

  @@index([isPublished, tier])
}

model EventSponsor {
  id        String  @id @default(uuid())
  eventId   String
  sponsorId String
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sponsor   Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@unique([eventId, sponsorId])
}

model EventTicket {
  id                String              @id @default(uuid())
  eventId           String
  name              String
  price             Float               @default(0.0)
  currency          String              @default("USD")
  description       String?
  quantityAvailable Int                 @default(100)
  quantitySold      Int                 @default(0)
  isAvailable       Boolean             @default(true)
  registrations     EventRegistration[]
  event             Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventRegistration {
  id               String       @id @default(uuid())
  eventId          String
  userId           String?
  ticketId         String?
  registrationCode String       @unique
  status           String       @default("CONFIRMED")
  registeredAt     DateTime     @default(now())
  attendeeName     String
  attendeeEmail    String
  attendeeCompany  String?
  event            Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket           EventTicket? @relation(fields: [ticketId], references: [id])
  user             User?        @relation(fields: [userId], references: [id])
  payments         Payment[]

  @@unique([eventId, attendeeEmail])
  @@index([eventId])
  @@index([userId])
  @@index([attendeeEmail])
}

model Payment {
  id                  String             @id @default(uuid())
  userId              String?
  eventRegistrationId String?
  amount              Float
  currency            String             @default("USD")
  status              String             @default("PENDING")
  provider            String             @default("MODULAR_GATEWAY")
  transactionId       String             @unique
  createdAt           DateTime           @default(now())
  eventRegistration   EventRegistration? @relation(fields: [eventRegistrationId], references: [id])
  user                User?              @relation(fields: [userId], references: [id])

  @@index([userId])
}

model BlogPost {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  summary         String
  content         String
  category        String   @default("Industry Insight")
  tags            String   @default("[]")
  imageUrl        String?
  authorName      String
  authorTitle     String
  authorAvatar    String?
  publishedAt     DateTime @default(now())
  isFeatured      Boolean  @default(false)
  isPublished     Boolean  @default(true)
  readTimeMinutes Int      @default(5)
  createdAt       DateTime @default(now())

  @@index([slug])
  @@index([isFeatured, publishedAt])
}

model FormSubmission {
  id               String   @id @default(uuid())
  userId           String?
  name             String
  email            String
  company          String?
  formType         String   @default("CONTACT")
  source           String?  @default("direct")
  campaign         String?  @default("organic")
  message          String
  metadataJson     String?  @default("{}")
  hubspotStatus    String   @default("PENDING")
  hubspotContactId String?
  isHandled        Boolean  @default(false)
  createdAt        DateTime @default(now())
  user             User?    @relation(fields: [userId], references: [id])

  @@index([formType])
  @@index([hubspotStatus])
  @@index([email])
}

model MediaAsset {
  id         String   @id @default(uuid())
  name       String
  url        String
  mimeType   String   @default("image/png")
  sizeBytes  Int      @default(0)
  category   String   @default("GENERAL")
  uploadedBy String?
  createdAt  DateTime @default(now())

  @@index([category])
  @@index([createdAt])
}

model ChatMessage {
  id          String   @id @default(uuid())
  senderId    String
  channel     String?  @default("general")
  recipientId String?
  content     String
  imageUrl    String?
  attachments String   @default("[]")
  reactions   String   @default("{}")
  createdAt   DateTime @default(now())
  recipient   User?    @relation("ReceivedMessages", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([channel])
  @@index([senderId])
  @@index([recipientId])
  @@index([createdAt])
}

// One read receipt per member per conversation - the high-water mark of what
// they have seen. conversationId is a single composite key ("ch:general" or
// "dm:<peerUserId>") rather than two nullable columns, because Postgres treats
// NULLs as distinct in a unique index and would happily store duplicates.
model ChatRead {
  id             String   @id @default(uuid())
  userId         String
  conversationId String
  lastReadAt     DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([conversationId])
}

model SiteNotification {
  id          String   @id @default(uuid())
  title       String
  message     String
  type        String   @default("INFO")
  linkUrl     String?
  linkText    String?
  targetRole   String   @default("ALL")
  targetUserId String?
  isPinned     Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation(fields: [createdById], references: [id])

  @@index([isActive, createdAt])
}

model CustomScript {
  id            String   @id @default("default")
  headerCode    String   @default("")
  footerCode    String   @default("")
  pageBodyCodes Json     @default("{}")
  updatedAt     DateTime @updatedAt
}
